# Variables PRIVÉES du processus serveur ; ne jamais ajouter le préfixe VITE_.
# Sans configuration complète, le connecteur ne se connecte à aucune boîte.
MOTEK_IMAP_ENABLED=0
MOTEK_IMAP_HOST=
MOTEK_IMAP_USER=
MOTEK_IMAP_PASSWORD=
MOTEK_IMAP_FOLDER=INBOX
# Date inclusive YYYY-MM-DD de début d'import, choisie par le bureau.
MOTEK_IMAP_SINCE=
# Secret aléatoire >=24 caractères, distinct du mot de passe de la boîte.
MOTEK_IMAP_OPERATOR_TOKEN=
