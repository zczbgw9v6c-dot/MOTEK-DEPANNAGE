{
  "name": "autohub-3d",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "preview": "vite preview --host 127.0.0.1",
    "predev": "node scripts/prepare-ocr.mjs && node scripts/prepare-credits.mjs",
    "prebuild": "node scripts/prepare-ocr.mjs && node scripts/prepare-credits.mjs",
    "assets:import": "node scripts/import-assets.mjs",
    "format": "prettier --write src tests scripts index.html package.json tsconfig.json vite.config.ts",
    "verify:scan": "node --experimental-strip-types scripts/verify-scan.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "pdfjs-dist": "^6.4.299",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tesseract.js": "^7.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
